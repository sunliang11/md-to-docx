{
  "name": "md-to-docx Playground",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "Web Playground",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "pip install -e \".[web]\" && PYTHONPATH=scripts python -m md_to_docx.presets_build",
  "postStartCommand": "bash .devcontainer/start-playground.sh",
  "waitFor": "postStartCommand"
}
